# Security Headers cho toàn bộ site
# Áp dụng cho tất cả requests

/*
  # Basic Security Headers
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: "1; mode=block"
  Referrer-Policy: strict-origin-when-cross-origin

  # Content Security Policy
  Content-Security-Policy: default-src 'self' 'unsafe-inline' 'unsafe-eval'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; connect-src 'self' https:; media-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self' https:; frame-ancestors 'self' https://hoason10.com; frame-src 'self' https://hoason10.com; upgrade-insecure-requests; block-all-mixed-content

  # HSTS (HTTPS Only)
  Strict-Transport-Security: "max-age=31536000; includeSubDomains; preload"

  # Privacy and Access Control
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), ambient-light-sensor=()

  # Anti-Scraping
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff

  # Rate Limiting Hints
  X-RateLimit-Limit: 1000
  X-RateLimit-Remaining: 999
  X-RateLimit-Reset: 3600

  # Security Information
  X-Server-Protected: Cloudflare-Middleware
  X-Protection: Enabled

# Cho phép iframe truy cập vào game file
/bea-ton.html
  X-Frame-Options: ALLOW-FROM https://hoason10.com
  Content-Security-Policy: default-src 'self' 'unsafe-inline' 'unsafe-eval'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; connect-src 'self' https:; media-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self' https:; frame-src 'self' https://hoason10.com; frame-ancestors 'self' https://hoason10.com; upgrade-insecure-requests; block-all-mixed-content

# Static Assets - optimized caching
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/img/*
  Cache-Control: public, max-age=2592000, immutable

/css/*
  Cache-Control: public, max-age=2592000, immutable

/js/*
  Cache-Control: public, max-age=2592000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# API endpoints (nếu có)
/api/*
  X-RateLimit-Limit: 100
  X-RateLimit-Remaining: 99
  X-RateLimit-Reset: 60
  Content-Security-Policy: default-src 'self'; connect-src 'self' https:; method=GET POST; mode=cors; credentials=same-origin

# Admin pages (nếu có)
/admin/*
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# Sensitive file types
*.php
*.sh
*.py
*.pl
*.cgi
*.conf
*.config
*.env
*.key
*.pem
*.crt
  Content-Type: text/plain
  X-Content-Type-Options: nosniff
  Cache-Control: no-cache, no-store, must-revalidate

# Error pages
/error/*
  Cache-Control: no-cache, no-store, must-revalidate

# Game assets special headers
/bea-ton.html
  X-Game-Protection: Enabled
  X-Access-Method: iframe-only
  X-Device-Requirement: desktop-large-screen
  Cache-Control: no-cache, must-revalidate

# HTML pages general
/*.html
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex, nofollow

# XML and text files
/*.xml
/*.txt
/*.json
  Content-Type: application/xml
  Cache-Control: public, max-age=3600

# Media files
/*.jpg
/*.jpeg
/*.png
/*.gif
/*.webp
  Cache-Control: public, max-age=2592000, immutable
  X-Robots-Tag: noindex

/*.mp3
/*.mp4
/*.avi
/*.mov
  Cache-Control: public, max-age=2592000, immutable
